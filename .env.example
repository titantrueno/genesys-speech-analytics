# Copia este fichero como `.env` en la raíz y rellena los valores. `.env` no se versiona.

# Servicio de ingesta (FE011): credenciales OAuth (client credentials) de Genesys Cloud y región (p. ej. eu-west-1).
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=

# PostgreSQL de docker-compose.yml (usuario `speech`, base `speech_analytics`).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://speech:<POSTGRES_PASSWORD>@localhost:5432/speech_analytics

# Token compartido entre la API y el servicio de ingesta (p. ej. `openssl rand -hex 32`).
INGESTION_TOKEN=
# Opcional en la API: dónde escucha el servicio de ingesta.
# INGESTION_URL=http://localhost:8001

# Servicio de LLM (FE013): es el único proceso que lee las claves de los proveedores. Deja vacía la de un proveedor que
# no uses; sin ninguna, los flujos funcionan con el proveedor «Simulado».
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Token compartido entre la API y el servicio de LLM (p. ej. `openssl rand -hex 32`).
LLM_TOKEN=
# Opcionales: llamadas simultáneas a los proveedores (1–64, 4 por defecto) y, en la API, dónde escucha el servicio.
# LLM_MAX_CONCURRENCY=4
# LLM_URL=http://localhost:8002
