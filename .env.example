# Copia este fichero como `.env` en la raíz y rellena los valores. `.env` no se versiona.

# Servicio de ingesta (FE011): credenciales OAuth (client credentials) de Genesys Cloud y región (p. ej. eu-west-1).
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=

# PostgreSQL de docker-compose.yml (usuario `speech`, base `speech_analytics`).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://speech:<POSTGRES_PASSWORD>@localhost:5432/speech_analytics

# Token compartido entre la API y el servicio de ingesta (p. ej. `openssl rand -hex 32`).
INGESTION_TOKEN=
# Opcional en la API: dónde escucha el servicio de ingesta.
# INGESTION_URL=http://localhost:8001
